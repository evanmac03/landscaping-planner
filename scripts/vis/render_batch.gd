class_name VisRenderBatch
extends RefCounted
## A list of stills to render, and the record of what came back.
##
## A batch is deliberately *not* a loop: rendering a still waits on real frames, so a
## batch that drove them itself would be a coroutine nobody could test. Instead this is
## the ledger. `next_job()` hands out the first job not yet attempted, `record()` files
## the outcome, and a caller - the dock, the game, a test - drives the loop at whatever
## pace the renderer needs:
##
## ```gdscript
## while not batch.is_done():
##     var job: Dictionary = batch.next_job()
##     var path: String = await render_one(job)
##     batch.record(job["name"], path)
## ```
##
## A job that comes back empty is recorded as a failure and the batch carries on, so one
## view that would not render does not cost the other three. And it is a *list*: two jobs
## with one name is one job, and the second is refused naming the first.

## The most a batch will hold. A batch is four views or a handful of sheets, not a
## render farm; a file with more than this is a file somebody generated by mistake.
const MAX_JOBS := 64

## The views this project can render, for the "render everything" button. A view whose
## renderer does not exist yet is refused by the executor in words rather than produced
## as a blank image (§11.3's spirit: name the thing to fix).
const DEFAULT_VIEWS: Array[String] = [
	"Working plan", "Painted plan", "3D presentation", "Sun study",
]

var _jobs: Array[Dictionary] = []
var _results: Array[Dictionary] = []


## Add a still to the batch. Refused when the name is already taken or the batch is
## full, in both cases saying so.
func add(name: String, preset, view: String = "3D presentation", flatten: bool = true, note: String = "") -> bool:
	if name.strip_edges().is_empty():
		return false
	if _jobs.size() >= MAX_JOBS:
		return false
	for job: Dictionary in _jobs:
		if String(job["name"]) == name:
			return false
	_jobs.append({
		"name": name,
		"preset": StringName(preset),
		"view": view,
		"flatten": flatten,
		"note": note,
	})
	return true


## Every job, in the order they were added.
func jobs() -> Array[Dictionary]:
	return _jobs.duplicate(true)


func count() -> int:
	return _jobs.size()


func is_empty() -> bool:
	return _jobs.is_empty()


## The jobs' names, in order.
func names() -> Array[String]:
	var out: Array[String] = []
	for job: Dictionary in _jobs:
		out.append(String(job["name"]))
	return out


## One entry per default view, at one size. A view already in the batch is added once.
func add_every_view(preset, views: Array = DEFAULT_VIEWS) -> int:
	var added := 0
	for view: String in views:
		if add(view, preset, view):
			added += 1
	return added


## The first job not yet attempted, or {} when there is none left.
func next_job() -> Dictionary:
	for job: Dictionary in _jobs:
		if not _has_result(String(job["name"])):
			return job
	return {}


## File the outcome of a job: `path` is "" when it could not be rendered. The job's own
## words on a failure come from the renderer's signal, not from here.
func record(name: String, path: String) -> bool:
	if not _has_job(name):
		return false
	if _has_result(name):
		return false
	_results.append({"name": name, "path": path, "ok": path != ""})
	return true


## Every outcome, in the order they were recorded.
func results() -> Array[Dictionary]:
	return _results.duplicate(true)


## Whether every job has an outcome.
func is_done() -> bool:
	return not _jobs.is_empty() and _results.size() >= _jobs.size()


## How many jobs have been attempted.
func attempted() -> int:
	return _results.size()


## How many came back with a file.
func succeeded() -> int:
	var out := 0
	for entry: Dictionary in _results:
		if bool(entry["ok"]):
			out += 1
	return out


## How many did not.
func failed() -> int:
	return _results.size() - succeeded()


## The jobs still waiting, as a count.
func waiting() -> int:
	return _jobs.size() - _results.size()


## The batch's state in one line, for a status bar or a panel.
func summary() -> String:
	if _jobs.is_empty():
		return "nothing to render"
	if not is_done():
		return "%d of %d stills rendered, %d waiting" % [attempted(), _jobs.size(), waiting()]
	if failed() == 0:
		return "%d of %d stills rendered" % [succeeded(), _jobs.size()]
	return "%d of %d stills rendered, %d could not be" % [succeeded(), _jobs.size(), failed()]


## The batch as one line per job, for a report or a test.
func report_text() -> String:
	var lines: Array[String] = []
	for job: Dictionary in _jobs:
		var name := String(job["name"])
		var outcome := _result_for(name)
		if outcome.is_empty():
			lines.append("%s (%s) - waiting" % [name, VisStillPreset.label(job["preset"])])
		elif bool(outcome["ok"]):
			lines.append("%s (%s) - %s" % [name, VisStillPreset.label(job["preset"]), String(outcome["path"])])
		else:
			lines.append("%s (%s) - could not be rendered" % [name, VisStillPreset.label(job["preset"])])
	return "\n".join(lines)


## Why the batch cannot be driven right now, or "" when it can. The two reasons are the
## empty batch and the finished one, both of which are states rather than errors.
func refusal() -> String:
	if _jobs.is_empty():
		return "there is nothing in the batch to render."
	if is_done():
		return "every still in the batch has been rendered."
	return ""


## Drive the batch with a *synchronous* executor: a callable taking a job and returning
## the file it wrote, or "" for a failure. The convenience for tests and for a renderer
## that does not wait on frames; an asynchronous renderer is driven through
## `next_job()`/`record()` rather than through here, because a `Callable` cannot be
## awaited across a coroutine boundary.
func run(executor: Callable) -> Dictionary:
	while not is_done():
		var job: Dictionary = next_job()
		if job.is_empty():
			break
		var path: String = String(executor.call(job))
		record(String(job["name"]), path)
	return {"ok": is_done(), "succeeded": succeeded(), "failed": failed(), "waiting": waiting()}


## Forget the jobs and the outcomes: a batch is a thing a person makes once.
func clear() -> void:
	_jobs.clear()
	_results.clear()


func _has_job(name: String) -> bool:
	for job: Dictionary in _jobs:
		if String(job["name"]) == name:
			return true
	return false


func _has_result(name: String) -> bool:
	return not _result_for(name).is_empty()


func _result_for(name: String) -> Dictionary:
	for entry: Dictionary in _results:
		if String(entry["name"]) == name:
			return entry
	return {}