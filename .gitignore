# Godot 4+ specific ignores
.godot/
/android/

# Rasterised previews of plotted output, kept out of the repository on purpose: a
# committed picture of a sheet goes stale the moment the exporter changes and then
# disagrees with the code in silence. Regenerate with tools/sample_sheets.gd, or look
# at the PDF itself.
preview/

# Ziva editor tooling: installed by the plugin, ~1.5 GB of vendored
# platform binaries (CEF / zivacode). Not part of this project's source.
addons/ziva_agent/

# Ziva's own QA-run scratch (run_scene / run_tests output). Not project source.
.ziva/

# Scratch written by a one-off tool run: a temp render, a probe image, a dump. Not
# project source - if something is worth keeping it belongs in a tool's own output
# folder, not at the root.
tmp_*

# The exported build. A tool run produces it, so it is not source: `build/` is where
# `--export-debug "Android (phone)"` puts the APK, and the preset is the file to keep.
build/

# The MCP bridge is somebody else's addon, installed rather than written here. Its
# sibling `addons/ziva_agent/` is ignored for the same reason; `addons/context_tools/`
# is not, because that one is this project's own AI Context dock.
addons/godot_ai/
